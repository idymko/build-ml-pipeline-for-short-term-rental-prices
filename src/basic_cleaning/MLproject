name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Name of input input datafile
        type: string

      output_artifact:
        description: Name of output cleaned file
        type: string

      output_type:
        description: Type of output file
        type: string

      output_description:
        description: Decsription of output file
        type: string

      min_price:
        description: Minimum pirce in the cleaned dataset
        type: float

      max_price:
        description: Maximum pirce in the cleaned dataset
        type: float

    command: >-
        python run.py  --input_artifact {input_artifact} \
                       --output_artifact {output_artifact} \
                       --output_type {output_type} \
                       --output_description {output_description} \
                       --min_price {min_price} \
                       --max_price {max_price}
